# Project-wide ignore rules

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Internal context and audit standards
context.md
PORTFOLIO-STANDARDS.md

# OS metadata
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node / Frontend build artifacts
node_modules/
client/node_modules/
client/build/
client/.pnp
client/.pnp.js
client/coverage/

# Java / Maven build artifacts
target/
server/target/
server/.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# IDE & Editor files
.idea/
client/.idea/
server/.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.project
.classpath
.factorypath
.apt_generated
.springBeans
.sts4-cache
