# Frontend Configuration (client/)
REACT_APP_API_URL=http://localhost:8080/api

# Backend Server Configuration (server/)
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Configuration (Dev profile)
DB_URL=jdbc:mysql://localhost:3306/campus_portal_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

